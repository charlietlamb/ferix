{
  "name": "ferix-code",
  "version": "0.0.5",
  "description": "Composable RALPH loops for AI coding agents - v2 with Effect",
  "type": "module",
  "bin": {
    "ferix": "dist/index.js",
    "ferix-code": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "bun run build && bun --conditions=browser --watch src/index.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:errors": "bun test tests/error-paths",
    "test:properties": "bun test tests/properties",
    "bump": "npm version prerelease --preid=beta --workspaces=false && bun run build && bun publish --tag beta",
    "patch": "npm version patch --workspaces=false && bun run build && bun publish --tag latest"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@opentui/core": "^0.1.75",
    "@opentui/solid": "^0.1.75",
    "commander": "^14.0.0",
    "convex": "catalog:",
    "effect": "^3.19.15",
    "human-id": "^4.1.3",
    "ora": "^9.1.0",
    "picocolors": "^1.1.1",
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "@ferix/server": "*",
    "@types/bun": "latest",
    "@types/node": "^22.15.3",
    "fast-check": "^3.22.0",
    "tsup": "^8.4.0",
    "typescript": "5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "ai",
    "ralph",
    "claude",
    "coding-agent",
    "automation",
    "effect"
  ],
  "license": "MIT"
}
