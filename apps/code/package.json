{
  "name": "ferix-code",
  "version": "0.0.2-beta.10",
  "description": "Composable RALPH loops for AI coding agents - v2 with Effect",
  "type": "module",
  "bin": {
    "ferix": "dist/index.js",
    "ferix-code": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "bump": "npm version prerelease --preid=beta --workspaces=false && bun run build && bun publish --tag beta"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "effect": "^3.19.15",
    "human-id": "^4.1.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.15.3",
    "tsup": "^8.4.0",
    "typescript": "5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "ai",
    "ralph",
    "claude",
    "coding-agent",
    "automation",
    "effect"
  ],
  "license": "MIT"
}
