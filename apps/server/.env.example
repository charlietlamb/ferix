# Convex Deployment (auto-generated by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-min-32-chars

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# GitHub Personal Access Token (for repository sync, create at https://github.com/settings/tokens)
GITHUB_TOKEN=ghp_your_personal_access_token

# Frontend URL (must match NEXT_PUBLIC_SITE_URL in apps/web)
FRONTEND_URL=http://localhost:3003

# Resend Email (optional, for email notifications - https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
