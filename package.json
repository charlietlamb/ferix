{
  "name": "ferix",
  "private": true,
  "scripts": {
    "clean:branches": "git branch --format='%(refname:short)' --list 'ferix/*' | xargs git branch -D",
    "build": "turbo run build",
    "build:cli": "bun run --filter=ferix-code build",
    "cli": "bun build:cli && node apps/cli/dist/index.js",
    "dev": "turbo run dev --filter=@ferix/web --filter=@ferix/server",
    "prod": "turbo run prod --filter=@ferix/web",
    "lint": "bunx biome lint",
    "format": "bunx biome format --write",
    "check-types": "turbo run check-types",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "knip:fix-all": "knip --fix --allow-remove-files",
    "prepare": "husky",
    "test": "echo 'No tests yet'",
    "bump": "cd apps/cli && bun bump",
    "patch": "cd apps/cli && bun run patch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "husky": "^9.1.7",
    "knip": "^5.44.0",
    "turbo": "^2.7.3",
    "typescript": "5.9.2",
    "ultracite": "7.0.11"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2",
      "@types/node": "^22.15.3",
      "typescript": "5.9.2",
      "next": "16.1.1",
      "tailwindcss": "^4",
      "postcss": "^8",
      "@tailwindcss/postcss": "^4",
      "tw-animate-css": "^1.4.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "tailwind-merge": "^3.4.0",
      "@icons-pack/react-simple-icons": "^13.8.0",
      "@phosphor-icons/react": "^2.1.7",
      "@base-ui/react": "^1.0.0",
      "convex": "^1.25.0",
      "@convex-dev/better-auth": "^0.10.9",
      "@convex-dev/migrations": "^0.1.4",
      "@convex-dev/workpool": "^0.3.1",
      "better-auth": "^1.4.12",
      "@t3-oss/env-nextjs": "^0.11.1",
      "zod": "^4.3.5",
      "@tanstack/react-form": "^1.0.0",
      "cmdk": "^1.1.1",
      "date-fns": "^4.1.0",
      "embla-carousel-react": "^8.6.0",
      "input-otp": "^1.4.2",
      "next-themes": "^0.4.6",
      "react-day-picker": "^9.13.0",
      "react-resizable-panels": "^4.3.3",
      "recharts": "2.15.4",
      "sonner": "^2.0.7",
      "vaul": "^1.1.2",
      "next-intl": "^4.1.0",
      "better-result": "^1.0.0",
      "jotai": "^2.12.5",
      "resend": "^4.0.0",
      "slugify": "^1.6.6",
      "use-debounce": "^10.0.4",
      "motion": "^12.0.0",
      "nuqs": "^2.8.6",
      "posthog-js": "^1.324.1",
      "@posthog/react": "^1.5.2",
      "@dnd-kit/core": "^6.3.1",
      "@dnd-kit/sortable": "^10.0.0",
      "@dnd-kit/utilities": "^3.2.2",
      "@clack/prompts": "^0.10.0"
    }
  }
}
